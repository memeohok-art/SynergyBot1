# Copy this file to `.env` next to bot.py — the bot loads it automatically.
# Never commit the real one to GitHub.

# Your bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Command prefix
PREFIX=!

# YouTube handle that !notify watches for
WATCH_HANDLE=themasteroogway_

# Who gets the !notify DMs. 0 = the application's owner.
# Right-click yourself in Discord (Developer Mode on) -> Copy User ID
OWNER_ID=0

# Staff role that can see and answer every ticket.
SUPPORT_ROLE_ID=1564953055450112096

# Category that ticket channels are created in (create a "Tickets" category,
# right-click it -> Copy ID, paste below). 0 = server root.
TICKET_CATEGORY_ID=0

# Channel for mod-log entries and failed-DM notices. 0 = off.
LOG_CHANNEL_ID=0

# Seconds between !notify DMs per user
COOLDOWN_SECONDS=20
